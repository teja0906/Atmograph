# ==============================================================================
# AtmoGraph - Enterprise Supply Chain Ripple Effect Predictor
# Environment Configuration Template
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Neo4j Graph Database Configuration
# When ENABLE_NEO4J_REMOTE=false or Neo4j server is unreachable, AtmoGraph
# seamlessly falls back to the embedded NetworkX graph engine with identical Cypher schema.
ENABLE_NEO4J_REMOTE=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atmograph_secure_pass

# Machine Learning & AI Settings
GNN_MODEL_PATH=backend/app/ml/checkpoints/supply_chain_gnn.pt
GNN_METRICS_PATH=backend/app/ml/checkpoints/model_metrics.json
SPACY_MODEL=en_core_web_sm

# Risk Scoring Weights (Must sum to 1.0)
WEIGHT_CASCADE_PROB=0.30
WEIGHT_UPSTREAM_DEP=0.25
WEIGHT_SOLE_SOURCE=0.20
WEIGHT_BUFFER_DEFICIT=0.15
WEIGHT_GEO_VULNERABILITY=0.10
